# Para empezar SIN instalar PostgreSQL (base persistente SQLite)
DATABASE_URL=sqlite:///./ecogestion.db
# Antes de publicar/cargar datos reales: reemplazar por una clave aleatoria larga
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_MINUTES=120
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
